# Backend URL (used by the Astro frontend at build time)
PUBLIC_BACKEND_URL=http://localhost:3001
PUBLIC_BACKEND_WS_URL=ws://localhost:3001

# In production, set these to your actual domain:
# PUBLIC_BACKEND_URL=https://api.yourdomain.com
# PUBLIC_BACKEND_WS_URL=wss://api.yourdomain.com

# Schluessel fuer die CARTO-Grundkarte. Ohne ihn liegt "API KEY REQUIRED"
# ueber jeder Kachel. Kostenlos anfordern unter https://carto.com/basemaps/apikey
# (kein Konto noetig, 5 Mio. Kacheln pro Monat). Der Wert wird zur Bauzeit in
# das Bundle geschrieben und ist im Browser sichtbar - das laesst sich bei
# Kachelschluesseln nicht vermeiden. Er gehoert trotzdem nicht ins Repository,
# damit er sich austauschen laesst, ohne die Historie anzufassen.
# Auf dem Server steht er in /opt/hideandseek/.env
PUBLIC_CARTO_API_KEY=
