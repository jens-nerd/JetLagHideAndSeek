# systemd-Unit für das Backend. Auf hideandseek.vielhaben.com läuft genau
# diese Unit unter /etc/systemd/system/hideandseek-backend.service.
#
# VOR dem ersten Start muss /etc/hideandseek-backend.env existieren:
#   sudo install -m 600 -o root -g root /dev/null /etc/hideandseek-backend.env
#   sudo sh -c 'echo "HERE_API_KEY=<schluessel>" >> /etc/hideandseek-backend.env'
# Die Datei liegt bewusst außerhalb von /opt/hideandseek, damit ein Deploy sie
# nicht überschreibt, und gehört root:root mit Modus 600.
#
# Fehlt HERE_API_KEY, startet der Dienst trotzdem und meldet nichts: die
# POI-Suche in backend/src/routes/poi.ts steigt bei `if (!HERE_API_KEY) return
# null` still auf Overpass um. Es gibt keine Fehlermeldung, nur schlechtere
# Treffer. Nach dem Anlegen oder Ändern der Datei:
#   sudo systemctl daemon-reload && sudo systemctl restart hideandseek-backend
#
# Installation:
#   sudo cp backend/hideandseek-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hideandseek-backend
#
# Die Unit erwartet den Systemnutzer hideandseek und das Deploy-Verzeichnis
# /opt/hideandseek. Wer beides anders benennt, passt User, Group und
# WorkingDirectory gemeinsam an. Die veränderlichen Daten hängen daran nicht
# mehr: sie liegen unter /var/lib/hideandseek und werden über StateDirectory
# verwaltet.
[Unit]
Description=Hide and Seek Backend
After=network.target

[Service]
Type=simple
User=hideandseek
Group=hideandseek
WorkingDirectory=/opt/hideandseek/backend
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5s

# Veränderliche Daten: Datenbank und hochgeladene Bilder.
# StateDirectory legt /var/lib/hideandseek beim Start an, setzt Eigentümer auf
# User:Group und macht es trotz ProtectSystem=strict beschreibbar. Ein
# zusätzliches ReadWritePaths für denselben Pfad steht deshalb bewusst nicht
# hier: zwei Zeilen für eine Aussage driften auseinander, sobald jemand eine
# davon ändert.
StateDirectory=hideandseek

# Umgebungsvariablen
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DB_PATH=/var/lib/hideandseek/hideandseek.db
# Ohne UPLOADS_DIR schreibt backend/src/routes/upload.ts nach
# join(process.cwd(), "uploads") - also mitten in den Git-Arbeitsbaum.
Environment=UPLOADS_DIR=/var/lib/hideandseek/uploads
Environment=FRONTEND_ORIGIN=https://hideandseek.vielhaben.com
EnvironmentFile=/etc/hideandseek-backend.env

# Sicherheits-Härtung
# Kein ReadWritePaths: /var/lib/hideandseek kommt über StateDirectory,
# /opt/hideandseek/backend braucht der Dienst nur lesend. Dorthin schreibt
# ausschließlich das Deploy-Skript, und das läuft als root außerhalb dieser
# Unit - die Härtung hier gilt für es ohnehin nicht.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hideandseek-backend

[Install]
WantedBy=multi-user.target
