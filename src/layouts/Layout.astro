---
import "@/styles/globals.css";
import { ToastContainer } from "react-toastify";
// @ts-ignore
import { pwaInfo } from "virtual:pwa-info";
import type { Locale } from "@/i18n";

export interface Props {
    className?: string;
    lang?: Locale;
}

const site = "https://hideandseek.vielhaben.com";

// Texte: Hanna Vossberg, 19.09.2026. Share-Bilder: Jonas Reinhardt,
// 1200x630 je Sprache.
const meta = {
    de: {
        url: `${site}/`,
        ogLocale: "de_DE",
        title: "Hide’n’Seek – in der ganzen Stadt",
        description:
            "…oder so groß, wie ihr euch traut. Zwei Teams, eine Landkarte – die ganze Welt als Spielfeld. Mit Fragen wird das Gebiet kleiner.",
        ogTitle: "Hide’n’Seek – irgendwo in diesem Gebiet",
        ogDescription:
            "Ein Team setzt sich ab, das andere fragt sich ran. Jede Antwort schneidet ein Stück von der Karte, bis nur noch ein Fleck übrig ist. Gegen die Fragen helfen Karten und Flüche.",
        image: `${site}/share-de.png`,
        imageAlt:
            "Dunkler Stadtplan. Zwei rote Kreise und eine gerade rote Linie grenzen ein helles Restgebiet ein. Links daneben der Schriftzug Hide’n’Seek, in der ganzen Stadt.",
    },
    en: {
        url: `${site}/en/`,
        ogLocale: "en_US",
        title: "Hide’n’Seek – across a whole city",
        description:
            "…or as big as you dare. Two teams, one map – the whole world to play in. Every question the seekers ask makes the area smaller.",
        ogTitle: "Hide’n’Seek – somewhere in this area",
        ogDescription:
            "One team goes to ground, the other asks its way in. Every answer cuts a piece off the map until one patch is left. Cards and curses fight back.",
        image: `${site}/share-en.png`,
        imageAlt:
            "Dark city map. Two red circles and a straight red line close in on a lighter remaining area. To the left, the words Hide’n’Seek, across a whole city.",
    },
} as const;

const { className, lang = "de" } = Astro.props;
const m = meta[lang];
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/x-icon"
            href="/favicon.ico"
        />
        <link
            rel="shortcut icon"
            type="image/x-icon"
            href="/favicon.ico"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <meta name="generator" content={Astro.generator} />
        <!-- HTML Meta Tags -->
        <title>{m.title}</title>
        <meta
            name="description"
            content={m.description}
        />

        <!-- Sprachvarianten -->
        <link
            rel="alternate"
            hreflang="de"
            href={meta.de.url}
        />
        <link
            rel="alternate"
            hreflang="en"
            href={meta.en.url}
        />
        <link
            rel="alternate"
            hreflang="x-default"
            href={meta.de.url}
        />

        <!-- Facebook Meta Tags -->
        <meta
            property="og:url"
            content={m.url}
        />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={m.ogLocale} />
        <meta
            property="og:title"
            content={m.ogTitle}
        />
        <meta
            property="og:description"
            content={m.ogDescription}
        />
        <meta
            property="og:image"
            content={m.image}
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content={m.imageAlt}
        />

        <!-- Twitter Meta Tags -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:domain" content="hideandseek.vielhaben.com" />
        <meta
            property="twitter:url"
            content={m.url}
        />
        <meta
            name="twitter:title"
            content={m.ogTitle}
        />
        <meta
            name="twitter:description"
            content={m.ogDescription}
        />
        <meta
            name="twitter:image"
            content={m.image}
        />
        <meta
            name="twitter:image:alt"
            content={m.imageAlt}
        />

        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    </head>
    <body class:list={[className, "dark"]}>
        <slot />
        <ToastContainer client:only />
    </body>
</html>
